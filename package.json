{
  "name": "@toolbuilder/make-factory",
  "version": "0.1.5",
  "description": "Generate a factory method from a class constructor function. Adds static methods from all super classes.",
  "keywords": [
    "javascript",
    "factory",
    "new"
  ],
  "homepage": "https://github.com/toolbuilder/make-factory#readme",
  "bugs": {
    "url": "https://github.com/toolbuilder/make-factory/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toolbuilder/make-factory.git"
  },
  "license": "MIT",
  "author": "Kevin Hudson",
  "type": "module",
  "main": "./src/factory.js",
  "types": "./src/factory.d.ts",
  "exports": {
    ".": {
      "types": "./src/factory.d.ts",
      "default": "./src/factory.js"
    }
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc",
    "test": "node --test 'test/**/*.test.js'",
    "check": "pnpm run check:types && pnpm run build && pnpm test",
    "validate:package": "npx -y publint && npx -y @arethetypeswrong/cli --pack . --profile esm-only",
    "release": "changelogen --release --no-github"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "changelogen": "^0.6.2",
    "typescript": "^5.6.3"
  }
}
